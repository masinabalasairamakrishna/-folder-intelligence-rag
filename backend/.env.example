# Application Settings
PROJECT_NAME="Folder Intelligence RAG System"
VERSION="1.0.0"
API_V1_STR="/api"
SECRET_KEY="super-secret-key-change-this-in-production-btech-project-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default is SQLite for instant zero-config launch.
# To use MySQL 8.0, change to: mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/folder_rag
DATABASE_URL=sqlite:///./folder_rag.db
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/folder_rag

# Storage Paths
UPLOAD_DIR=../../storage/uploads
CHROMA_PERSIST_DIR=../../storage/chroma_data

# Google Gemini API
# Get your free key from https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# RAG Hyperparameters
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_TOP_K=5

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
